# SARURA backend environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests (the Vite dev server, then production).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Non-obvious URL path for Django's built-in admin (always end with a slash).
DJANGO_ADMIN_URL=sarura-admin/
# Where the React app runs; verification and password-reset links point here.
FRONTEND_URL=http://localhost:5173

# --- Email (development prints emails to the console) ---
# Production: django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST etc.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SARURA <no-reply@sarura.rw>
# Public Contact Us enquiries go here, at most CONTACT_RATE_LIMIT per IP.
CONTACT_EMAIL=hello@sarura.rw
CONTACT_RATE_LIMIT=5/hour

# --- Authentication rate limits (per client IP) ---
LOGIN_RATE_LIMIT=10/min
REGISTER_RATE_LIMIT=5/hour
PASSWORD_RESET_RATE_LIMIT=10/hour
# Session lifetime in seconds (default: two weeks).
SESSION_COOKIE_AGE=1209600

# --- PostgreSQL ---
POSTGRES_DB=sarura
POSTGRES_USER=sarura
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
